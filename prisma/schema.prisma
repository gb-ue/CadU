generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Aluno {
  id_Aluno    Int                       @id
  Modalidade  String                    @db.VarChar(255)
  Curso       String                    @db.VarChar(255)

  usuario_academico Usuario_Academico   @relation(fields: [id_Aluno], references: [id_Usuario_Academico])
}

model Categoria {
  id_categoria Int                      @id @default(autoincrement())
  Nome         String                   @db.VarChar(255)
  Oculto       Boolean                  @default(false)

  evento Evento []
}

model Convidado {
  id_Evento            Int
  id_Usuario_Academico Int

  evento Evento @relation(fields: [id_Evento],references: [id_Evento])
  usuario_academico Usuario_Academico @relation(fields: [id_Usuario_Academico], references: [id_Usuario_Academico])

  @@id([id_Evento, id_Usuario_Academico])
}

model Evento {
  id_Evento            Int              @id @default(autoincrement())
  id_Organizador       Int
  id_categoria         Int
  id_Grupos_Convidados Int
  Nome_do_Evento       String           @db.VarChar(255)
  Descriçao            String           @db.VarChar(255)
  Local                String           @db.VarChar(255)
  Data_Horario         DateTime
  Data_Lembrete        DateTime
  Oculto               Boolean          @default(false)
  Recorrente           Boolean          @default(false)
  Tipo_Recorrencia     String           @db.VarChar(255)
  Recorrente_ate       DateTime         @db.Date

  faltas Faltas?
  organizador Usuario                   @relation(fields: [id_Organizador], references: [id_Usuario])
  categoria Categoria                   @relation(fields: [id_categoria], references: [id_categoria])
  grupo_convidado Grupo @relation(fields: [id_Grupos_Convidados], references: [id_Grupo])
  convidado Convidado []
}

model Faltas {
  id_Convidado Int
  id_Evento    Int                      @unique
  Num_Faltas   BigInt

  convidado Usuario_Academico           @relation(fields: [id_Convidado], references: [id_Usuario_Academico])
  evento Evento                         @relation(fields: [id_Evento], references: [id_Evento])
  @@id([id_Convidado, id_Evento])
}

model Grupo {
  id_Grupo       Int                    @id @default(autoincrement())
  Nome_Grupo     String                 @db.VarChar(255)
  id_Organizador Int

  organizador Usuario                   @relation(fields: [id_Organizador], references: [id_Usuario])
  lista Lista_Usuarios []
  evento Evento []
}

model Lista_Usuarios {
  id_Grupo             Int
  id_Usuario_Academico Int              @unique

  usuario Usuario_Academico             @relation(fields: [id_Usuario_Academico], references: [id_Usuario_Academico])
  grupo Grupo                           @relation(fields: [id_Grupo], references: [id_Grupo])

  @@id([id_Grupo, id_Usuario_Academico])
}

model Usuario {
  id_Usuario Int                        @id @default(autoincrement())
  email      String                     @map("E-mail") @unique @db.VarChar(255)
  Senha      String                     @db.VarChar(255)

  usuarioAcademico Usuario_Academico?
  usuarioAdministrador Usuario_Administrador?
  grupos Grupo []
  evento Evento []

}

model Usuario_Academico {
  id_Usuario_Academico Int              @id
  Nome                 String           @db.VarChar(255)

  aluno Aluno?
  lista_usuarios Lista_Usuarios?
  usuario Usuario                       @relation(fields: [id_Usuario_Academico], references: [id_Usuario])
  convidado Convidado []
  faltas Faltas []
}

model Usuario_Administrador {
  id_Admin Int                          @id

  usuario Usuario                       @relation(fields: [id_Admin], references: [id_Usuario])
}